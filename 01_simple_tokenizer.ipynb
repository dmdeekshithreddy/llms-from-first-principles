   "source": [
    "#### Step 1: Split the text into tokens using regex"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "9d720172",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Hello', ',', 'world', '.', 'Is', 'this', '--', 'a', 'test', '?']\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "text = \"Hello, world. Is this-- a test?\"\n",
    "result = re.split(r'([,.?]|--|\\s)', text)\n",
    "result = [token.strip() for token in result if token.strip()]\n",
    "print(result)"
   ]
  }
